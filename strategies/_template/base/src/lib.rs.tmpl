//! `{{name}}` (kind_id {{kind_id}}): strategy skeleton generated by `cargo xtask new-strategy`.
//! Specification: `strategies/{{name}}/README.md`. The skeleton subscribes to the BBO of every
//! group leg and keeps per-group quote state; it sends no intents until its rules are written.
#![forbid(unsafe_code)]
#![deny(
    clippy::float_arithmetic,
    clippy::unwrap_used,
    clippy::expect_used,
    clippy::panic,
    clippy::unreachable,
    clippy::todo,
    clippy::unimplemented
)]

pub mod desc;
pub mod fast;
pub mod params;

use hft_strategy_sdk::{
    Ctx, EventRef, GroupTable, NoModel, ParamError, Part, RefView, RestoreError, SnapshotReader,
    SnapshotWriter, Strategy, StrategyDesc, StrategyInstance, SubsBuilder, Views,
};

pub use params::{{{Type}}Fields, {{Type}}Params};

/// `StrategyDesc.version` (fast-part snapshot layout and decision semantics).
pub const DESC_VERSION: u16 = 1;

/// The strategy (registry row `{{crate}}::{{Type}}`).
#[derive(Debug)]
pub struct {{Type}} {
    pub inst: StrategyInstance,
    pub fast: fast::Fast,
}

impl Strategy for {{Type}} {
    const DESC: StrategyDesc = StrategyDesc {
        name: "{{name}}",
        kind_id: {{kind_id}},
        version: DESC_VERSION,
        non_prod_only: false,
        schema: &{{Type}}Params::SCHEMA,
        notes: &desc::NOTES,
        report: &desc::REPORT,
        cmds: &desc::CMDS,
    };
    type Params = {{Type}}Params;
    type Model = NoModel<{{Type}}Params>;

    fn new(
        inst: StrategyInstance,
        p: &{{Type}}Params,
        groups: &GroupTable,
        _rd: &RefView<'_>,
    ) -> Result<Self, ParamError> {
        Ok({{Type}} {
            inst,
            fast: fast::Fast::new(p, groups),
        })
    }

    fn subscriptions(&self, groups: &GroupTable, out: &mut SubsBuilder<'_>) {
        fast::subscribe(groups, Part::Fast, out);
    }

    fn on_event<V: Views>(&mut self, ev: &EventRef<'_>, v: &V, ctx: &mut Ctx<'_>) {
        self.fast.on_event(ev, v, ctx);
    }

    fn on_params(
        &mut self,
        p: &{{Type}}Params,
        groups: &GroupTable,
        _rd: &RefView<'_>,
    ) -> Result<(), ParamError> {
        self.fast.on_params(p, groups);
        Ok(())
    }

    fn snapshot(&self, w: &mut SnapshotWriter) {
        self.fast.snapshot(w);
    }

    fn restore(&mut self, r: &mut SnapshotReader<'_>) -> Result<(), RestoreError> {
        self.fast.restore(r)
    }
}
