"""Pipeline plugin of the {{name}} strategy (kind_id {{kind_id}}).

Skeleton generated by ``cargo xtask new-strategy --with-pipeline``. The plugin protocol is
``hft_pipeline.api`` (python/pipeline README "插件接口"); this skeleton owns no field and declares no
input, so the framework fills every field from manual overrides, the policy or the schema defaults.
``compute`` and ``explain`` are written together with the strategy's rules.
"""

from __future__ import annotations

STRATEGY_KIND = {{kind_id}}
API_VERSION = 1


class Plugin:
    """The plugin object the entry point names."""

    strategy_kind: int = STRATEGY_KIND
    api_version: int = API_VERSION
    owned_fields: frozenset[str] = frozenset()
    required_inputs: tuple = ()

    def compute(self, snap, policy):
        raise NotImplementedError("{{name}}: the plugin rules are not written yet")

    def explain(self, snap, policy, asset):
        return []


PLUGIN = Plugin()
