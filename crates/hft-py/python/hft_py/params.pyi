"""hft_py.params: SDK params codec (crates/hft-py/README.md "参数编码(`params`)")."""

from collections.abc import Mapping, Sequence
from decimal import Decimal
from os import PathLike
from typing import Any, final

__all__ = ["Error", "decode", "encode", "encode_cmd", "format_value", "load_schema", "load_schemas", "parse_value"]

_Value = str | int | Decimal

class _Schema:
    @property
    def kind_id(self) -> int: ...
    @property
    def name(self) -> str: ...
    @property
    def schema_id(self) -> int: ...
    @property
    def schema_version(self) -> int: ...
    @property
    def schema_digest(self) -> str: ...
    @property
    def fields(self) -> tuple[Mapping[str, Any], ...]: ...
    @property
    def cmds(self) -> tuple[Mapping[str, Any], ...]: ...
    @property
    def notes(self) -> tuple[Mapping[str, Any], ...]: ...
    @property
    def report(self) -> tuple[Mapping[str, Any], ...]: ...

@final
class Error:
    @property
    def variant(self) -> str: ...
    @property
    def field(self) -> str | None: ...
    @property
    def group_ix(self) -> int | None: ...

def load_schemas(dir: str | PathLike[str]) -> dict[int, _Schema]: ...
def load_schema(path: str | PathLike[str]) -> _Schema: ...
def encode(
    schema: _Schema,
    header: Mapping[str, Any],
    groups: Sequence[Mapping[str, Any]],
    defaults: Mapping[str, _Value] | None = None,
    overrides: Sequence[Mapping[str, Any]] | None = None,
) -> tuple[bytes | None, list[Error]]: ...
def decode(schemas: Mapping[int, _Schema] | _Schema, blob: bytes) -> dict[str, Any]: ...
def encode_cmd(schema: _Schema, op: str, values: Mapping[str, _Value]) -> bytes: ...
def parse_value(schema: _Schema, field: str, text: str, exp: int | None = None) -> int: ...
def format_value(schema: _Schema, field: str, raw: int, exp: int | None = None) -> str: ...
